# Configuration serveur
PORT=3000
NODE_ENV=development

# Configuration base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=votre_mot_de_passe
DB_NAME=projetx_db

# Configuration JWT
JWT_SECRET=votre_secret_jwt_tres_securise_a_changer
JWT_EXPIRES_IN=7d

# Configuration SMTP pour envoi emails (Nodemailer + MailerLite)
# Inscrivez-vous sur https://www.mailerlite.com
# Obtenez vos identifiants SMTP dans Settings > SMTP
SMTP_HOST=smtp.mailerlite.com
SMTP_PORT=587
SMTP_USER=votre_email_mailerlite@example.com
SMTP_PASSWORD=votre_cle_api_mailerlite

# URL frontend (pour les liens de vérification email)
FRONTEND_URL=http://localhost:8081

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
